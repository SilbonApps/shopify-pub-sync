{
  "name": "shopify-pub-sync",
  "version": "2.0.0",
  "type": "module",
  "description": "Publica o despublica productos en Shopify Markets segun el stock de la ubicacion central. Webhook inventory_levels/update -> SQS -> worker, en AWS Lambda.",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "test:lambda": "node test-lambda.local.mjs",
    "aws:deploy": "powershell -ExecutionPolicy Bypass -File ./aws/deploy.ps1",
    "update-webhook": "node scripts/update-webhook.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "Javier Garcia-Rojo Canton",
  "license": "ISC",
  "dependencies": {},
  "devDependencies": {
    "@aws-sdk/client-sqs": "^3.700.0",
    "@aws-sdk/client-ssm": "^3.700.0",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "morgan": "^1.10.1"
  }
}
